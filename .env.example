# CLI 自动读取启动目录的 .env；已有 shell 环境优先。不会保存密钥到会话。
# OpenAI Responses；模型必须自行填写为账户可用的支持工具调用的模型。
OPENAI_API_KEY=
KRAKEN_MODEL=
# 可选 OpenAI-compatible Chat Completions 服务（也适用于 Kimi）：
KRAKEN_API_KEY=
KRAKEN_BASE_URL=
# KRAKEN_PROVIDER=compatible
# Kimi 用户可设置 KRAKEN_BASE_URL=https://api.moonshot.cn/v1
# 并将自己的模型 ID 写入 KRAKEN_MODEL、密钥写入 KRAKEN_API_KEY。
