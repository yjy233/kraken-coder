# 复制到 .env。每个平台只需一把 Key，可在网页选择平台和模型。
KRAKEN_VOLCENGINE_API_KEY=
KRAKEN_OPENROUTER_API_KEY=

# 网页选择后会写入下面三项中的当前平台及对应的模型。
# 也可以手动取消注释，将模型 ID 替换成自己账户可用的值。
# KRAKEN_MODEL_PROVIDER=volcengine
# KRAKEN_VOLCENGINE_MODEL=你的方舟模型或接入点ID
# KRAKEN_OPENROUTER_MODEL=作者/模型ID

# 其他兼容服务沿用以下配置。已有配置火山或 OpenRouter 的 .env 可继续使用。
# KRAKEN_PROVIDER=compatible
# KRAKEN_BASE_URL=https://api.moonshot.cn/v1
# KRAKEN_MODEL=
# KRAKEN_API_KEY=

# OpenAI Responses 使用 KRAKEN_PROVIDER=responses 和 KRAKEN_MODEL。
# OPENAI_API_KEY=

# 时限单位为毫秒；网页“运行设置”保存时也会更新这两项。
KRAKEN_REQUEST_TIMEOUT_MS=180000
KRAKEN_TURN_TIMEOUT_MS=10800000

# 工具审批方式，可选 ask、auto-review、full-auto、read-only、workspace-write。
KRAKEN_APPROVAL=ask

# auto 读取模型接口返回的窗口。也可填正整数 token，填 0 使用本地字符预算。
KRAKEN_CONTEXT_WINDOW_TOKENS=auto
KRAKEN_CONTEXT_COMPACT_RATIO=0.8
