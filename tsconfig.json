{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"], "types": ["node"],
    "strict": true, "noUncheckedIndexedAccess": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "declaration": true, "sourceMap": true, "rootDir": "src", "outDir": "dist", "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
